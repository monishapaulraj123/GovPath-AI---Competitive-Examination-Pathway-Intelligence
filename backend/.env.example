# GovPath AI Backend Configuration
APP_NAME="GovPath AI"
ENVIRONMENT=development
SECRET_KEY=change-this-in-production-govpath-ai-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database: Defaults to local SQLite for zero-setup prototype; switch to PostgreSQL in production:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/govpath_ai
DATABASE_URL=sqlite:///./govpath_ai.db

# Optional Gemini LLM API Configuration (if GEMINI_API_KEY is omitted, deterministic grounded synthesis mode is active)
LLM_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT_SECONDS=30

# Bounded Orchestrator Limits
ORCHESTRATOR_MAX_ITERATIONS=4
ORCHESTRATOR_MAX_TOOL_CALLS=24
ORCHESTRATOR_MAX_LLM_CALLS=6
ORCHESTRATOR_TIMEOUT_SECONDS=45.0
ORCHESTRATOR_TOOL_TIMEOUT_SECONDS=10.0
ORCHESTRATOR_TOKEN_BUDGET=20000

# Optional External Graph / Vector Backends
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
CHROMA_PERSIST_DIR=./chroma_db

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
