# GovPath AI Backend Configuration
APP_NAME="GovPath AI"
ENVIRONMENT=development
SECRET_KEY=change-this-in-production-govpath-ai-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database: Defaults to local SQLite for zero-setup prototype; switch to PostgreSQL in production:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/govpath_ai
DATABASE_URL=sqlite:///./govpath_ai.db

# Optional LLM API Configuration (if omitted, deterministic grounded synthesis mode is active)
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional External Graph / Vector Backends
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
CHROMA_PERSIST_DIR=./chroma_db

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
